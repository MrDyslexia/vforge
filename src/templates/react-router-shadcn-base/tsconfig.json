{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ],
    "rootDirs": [
      ".",
      "./.react-router/types"
    ]
  },
  "include": [
    "src/**/*",
    "src/**/.server/**/*",
    "src/**/.client/**/*",
    ".react-router/types/**/*",
    "vite.config.ts",
    "react-router.config.ts"
  ]
}
