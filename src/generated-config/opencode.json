{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "vforge"
  ],
  "agent": {
    "vforge-builder": {
      "description": "Builds and evolves local Bun/React apps from vforge specs.",
      "mode": "subagent",
      "prompt": "./agents/vforge-builder.md",
      "permission": {
        "edit": "allow",
        "bash": "ask",
        "external_directory": {
          "*": "ask",
          "./**": "allow"
        }
      }
    }
  }
}
